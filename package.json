{
  "name": "machi-shirube",
  "version": "0.1.0",
  "private": true,
  "description": "町を選ぶと、その町で暮らしの情報が届きにくい人に届くページを出典つきで作る仕組み",
  "author": "tyra",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:japan-map": "mapshaper-xl 8gb data/raw/N03/N03-20260101.shp encoding=utf8 -rename-fields pref=N03_001,county=N03_003,city=N03_004,ward=N03_005,code=N03_007 -dissolve code copy-fields=pref,county,city,ward name=municipalities -simplify 1.5% weighted keep-shapes -dissolve pref + name=prefectures -o site/data/japan.topo.json format=topojson target=municipalities,prefectures quantization=100000 && mapshaper site/data/japan.topo.json -points inner target=municipalities -filter-fields code -o site/data/labels.json format=geojson precision=0.001 && mapshaper site/data/japan.topo.json -points inner target=prefectures -filter-fields pref -o site/data/pref-labels.json format=geojson precision=0.001",
    "build:stats": "node scripts/build-stats.mjs",
    "build:towns": "node scripts/build-towns.mjs",
    "build:census": "node scripts/build-census.mjs",
    "build:industry": "node scripts/build-industry.mjs",
    "build:features": "node scripts/build-features.mjs",
    "build:flags": "node scripts/build-flags.mjs",
    "build:shelters": "node scripts/build-shelters.mjs",
    "build:shelters-gsi": "node scripts/build-shelters-gsi.mjs",
    "build:jma": "node scripts/build-jma.mjs",
    "build:medical": "node scripts/build-medical.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:research": "node --env-file=.env scripts/serve.mjs",
    "research": "node --env-file=.env scripts/research.mjs",
    "recheck": "node --env-file=.env scripts/recheck.mjs",
    "translate": "node --env-file=.env scripts/translate.mjs",
    "i18n": "node --env-file=.env scripts/i18n.mjs",
    "propose": "node --env-file=.env scripts/propose.mjs",
    "gomi": "node --env-file=.env scripts/gomi.mjs",
    "gomi-days": "node --env-file=.env scripts/gomi-days.mjs",
    "watch": "node scripts/watch.mjs",
    "try:api": "node --env-file=.env scripts/try-api.mjs",
    "try:fetch": "node --env-file=.env scripts/try-fetch.mjs",
    "try:pdf": "node --env-file=.env scripts/try-pdf.mjs",
    "build:flood-pop": "node scripts/build-flood-pop.mjs",
    "build:accidents": "node scripts/build-accidents.mjs",
    "build:quake-pop": "node scripts/build-quake-pop.mjs",
    "build:shop-access": "node scripts/build-shop-access.mjs",
    "build:future": "node scripts/build-future.mjs",
    "build:bus": "node scripts/build-bus.mjs",
    "plan-excerpts": "node --env-file=.env scripts/plan-excerpts.mjs",
    "mitate": "node --env-file=.env scripts/mitate.mjs",
    "build:summary": "node scripts/build-summary.mjs",
    "build:muni": "node scripts/build-muni.mjs",
    "build:slope": "node scripts/build-slope.mjs",
    "build:climate": "node scripts/build-climate.mjs",
    "hitokoto": "node --env-file=.env scripts/hitokoto.mjs",
    "dekiru": "node --env-file=.env scripts/dekiru.mjs",
    "translate-ai": "node --env-file=.env scripts/translate-ai.mjs",
    "build:lore": "node scripts/build-lore.mjs",
    "mitate-ask": "node --env-file=.env scripts/mitate-ask.mjs",
    "local-sites": "node --env-file=.env scripts/local-sites.mjs",
    "build:shelter-inside": "node scripts/build-shelter-inside.mjs",
    "watch-recheck": "node --env-file=.env scripts/watch-recheck.mjs",
    "build:telops": "node scripts/build-telops.mjs",
    "build:aed": "node scripts/build-aed.mjs",
    "quiz": "node --env-file=.env scripts/quiz.mjs",
    "backup": "node scripts/backup-ledger.mjs",
    "preflight": "node scripts/preflight.mjs",
    "news": "node scripts/news.mjs",
    "split-tr": "node scripts/split-translations.mjs",
    "check": "node scripts/check.mjs",
    "intro": "node --env-file=.env scripts/intro.mjs"
  },
  "devDependencies": {
    "mapshaper": "^0.7.101"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "adm-zip": "^0.6.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pngjs": "^7.0.0"
  }
}
